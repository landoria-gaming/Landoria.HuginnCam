## Example BepInEx settings for the Valheim SagaCapture plugin.

[Controls]

## Enter or leave CaptureMode.
CaptureModeShortcut = F8

## Enter or leave PreviewMode. No recording.
PreviewModeShortcut = F8 + LeftShift

[CameraRendering]

## Drone-camera vertical field of view: SameAsGame or 40 to 120 degrees.
SagaCameraFOV = SameAsGame

## Valheim graphics preset used to render the drone camera before encoding:
## SameAsGame, VeryLow, Low, Medium, or High.
GraphicsPreset = SameAsGame

## Internal drone-camera resolution: SameAsGame, Preset (graphics preset value),
## HD720 (1280x720), FullHD1080 (1920x1080), QHD1440 (2560x1440),
## or UHD2160 (3840x2160).
Resolution = SameAsGame

## Frame rate shared by PreviewMode, CaptureMode, the Unity game loop,
## and the video recorder: 30 or 60 FPS. VSync is temporarily disabled
## so Unity does not render more frames than the recorder accepts.
MaximumFrameRate = 60

## Override camera depth of field: SameAsGame, Preset, Enabled, or Disabled.
DepthOfField = SameAsGame

## Override camera motion blur: SameAsGame, Preset, Enabled, or Disabled.
MotionBlur = SameAsGame

## Override camera bloom: SameAsGame, Preset, Enabled, or Disabled.
Bloom = SameAsGame

[VideoEncoding]

## Encoder quality preset for the output video: Low, Medium, or High.
Quality = Low

[Telemetry]

## Time between camera-position and orbit-motion samples, in seconds (0.1 to 5).
SampleIntervalSeconds = 0.5

## Collect flight diagnostics while PreviewMode controls the camera.
## Enabling diagnostics can noticeably slow down the game.
PreviewEnabled = true

## Collect flight diagnostics while CaptureMode controls the camera.
## Enabling diagnostics can noticeably slow down the game.
CaptureEnabled = false

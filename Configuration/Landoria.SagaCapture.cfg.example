## Example BepInEx settings for the Valheim SagaCapture plugin.

[Camera]

## Vertical field of view of the camera, in degrees (40 to 120).
SagaCameraFOV = 65

[Controls]

## Enter or leave CaptureMode.
CaptureModeShortcut = F8

## Enter or leave PreviewMode. No recording.
PreviewModeShortcut = F8 + LeftShift

[Telemetry]

## Session root directory passed to DronePilot.dll. Empty makes SagaCapture
## create BepInEx/config/SagaCapture in the current profile. DronePilot.dll
## creates Sessions/<session> subdirectories inside the supplied directory.
RootDirectory =

## Time between camera-position and orbit-motion samples, in seconds (0.1 to 5).
SampleIntervalSeconds = 0.5

## Collect flight diagnostics while PreviewMode controls the camera.
## Enabling diagnostics can noticeably slow down the game.
PreviewEnabled = true

## Collect flight diagnostics while CaptureMode controls the camera.
## Enabling diagnostics can noticeably slow down the game.
CaptureEnabled = false

      <Project>{8A80B99F-CA09-4E77-91EA-37267C259192}</Project>
      <Name>DronePilot</Name>
      <AdditionalProperties>UnityManagedPath=$(ValheimGamePath)\valheim_Data\Managed</AdditionalProperties>

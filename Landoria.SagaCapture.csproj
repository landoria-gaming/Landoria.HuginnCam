  </ItemGroup>
  <ItemGroup>
    <_SnapshotExtraFiles Include="$(MSBuildProjectDirectory)\bin\Release\Direct3DVideoEncoder.dll" Condition="Exists('$(MSBuildProjectDirectory)\bin\Release\Direct3DVideoEncoder.dll')" />
  </ItemGroup>
  <!-- Downloads and extracts the mutable camera recorder snapshot only when its ETag changes. -->
  <Target Name="UpdateCameraRecorderLibraries" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(CameraRecorderDownloadDirectory);$(MSBuildProjectDirectory)\lib" />
    <Exec Command="curl --fail --location --silent --show-error --etag-compare &quot;$(CameraRecorderEtag)&quot; --etag-save &quot;$(CameraRecorderDownloadedEtag)&quot; --output &quot;$(CameraRecorderArchive)&quot; --write-out &quot;%%{http_code}&quot; &quot;$(CameraRecorderAssetUrl)&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CameraRecorderDownloadOutput" />
    </Exec>
    <PropertyGroup>
      <_CameraRecorderHttpStatus>@(_CameraRecorderDownloadOutput)</_CameraRecorderHttpStatus>
    </PropertyGroup>
    <Error Condition="'$(_CameraRecorderHttpStatus)' != '200' And '$(_CameraRecorderHttpStatus)' != '304'"
           Text="Unexpected HTTP status $(_CameraRecorderHttpStatus) while downloading UnityRuntimeCameraRecorder." />
    <Delete Files="$(MSBuildProjectDirectory)\lib\UnityRuntimeCameraRecorder.dll;$(MSBuildProjectDirectory)\lib\FFmpegMediaWriter.dll;$(MSBuildProjectDirectory)\lib\Direct3DVideoEncoder.dll" Condition="'$(_CameraRecorderHttpStatus)' == '200'" />
    <Unzip SourceFiles="$(CameraRecorderArchive)"
           DestinationFolder="$(MSBuildProjectDirectory)\lib"
           Condition="'$(_CameraRecorderHttpStatus)' == '200'" />
    <Copy SourceFiles="$(CameraRecorderDownloadedEtag)"
          DestinationFiles="$(CameraRecorderEtag)"
          Condition="'$(_CameraRecorderHttpStatus)' == '200'" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>

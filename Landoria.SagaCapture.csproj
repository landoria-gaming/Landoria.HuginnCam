<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props"
          Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{3A8D7D61-C013-4D86-9962-95E57F7F6685}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>Landoria.SagaCapture</RootNamespace>
    <AssemblyName>Landoria.SagaCapture</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <UnityManagedPath>$(ValheimGamePath)\valheim_Data\Managed</UnityManagedPath>
    <ILRepackTargetsFile>$(MSBuildProjectDirectory)\ILRepack.targets</ILRepackTargetsFile>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <CineCaptureLatestReleaseUrl>https://github.com/cine-capture/CineCapture/releases/latest</CineCaptureLatestReleaseUrl>
    <CineCaptureDownloadDirectory>$(MSBuildProjectDirectory)\obj\$(Configuration)\downloads</CineCaptureDownloadDirectory>
    <CineCaptureArchive>$(CineCaptureDownloadDirectory)\CineCapture.zip</CineCaptureArchive>
    <CineCaptureEtag>$(MSBuildProjectDirectory)\lib\.CineCapture.etag</CineCaptureEtag>
    <CineCaptureDownloadedEtag>$(CineCaptureDownloadDirectory)\CineCapture.etag</CineCaptureDownloadedEtag>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols><DebugType>full</DebugType><Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath><DefineConstants>DEBUG;TRACE</DefineConstants><WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType><Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath><DefineConstants>TRACE</DefineConstants><WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" />
    <Reference Include="BepInEx"><HintPath>$(BepInExPath)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExPath)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_valheim"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_postprocessing"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\assembly_postprocessing.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ValheimGamePath)\valheim_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="CineCapture"><HintPath>$(MSBuildProjectDirectory)\lib\CineCapture.dll</HintPath><Private>true</Private></Reference>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.44" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="lib\Direct3DVideoEncoder.dll">
      <Link>Direct3DVideoEncoder.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Configuration\ConfigWatcher.cs" />
    <Compile Include="Configuration\Preference.cs" />
    <Compile Include="SagaCapturePlugin.cs" />
    <Compile Include="Director\ShotDirector.cs" />
    <Compile Include="Director\CameraPlacementDirector.cs" />
    <Compile Include="Capture\AudioListener.cs" />
    <Compile Include="Capture\FrameRateDisplay.cs" />
    <Compile Include="Capture\FrameRateLimit.cs" />
    <Compile Include="Capture\GameplayCapture.cs" />
    <Compile Include="Capture\VideoSource.cs" />
    <Compile Include="CinematicCamera\Rig.cs" />
    <Compile Include="CinematicCamera\ValheimCameraAdapter.cs" />
    <Compile Include="Rendering\CameraLogger.cs" />
    <Compile Include="Rendering\EffectMirror.cs" />
    <Compile Include="Rendering\Effects.cs" />
    <Compile Include="Rendering\Rendering.cs" />
    <Compile Include="Patches\FootstepVolumePatch.cs" />
    <Compile Include="Patches\PlayerVisibilityPatch.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LICENSE" /><Content Include="manifest.json" />
    <Content Include="README.md" />
  </ItemGroup>
  <ItemGroup>
    <_SnapshotExtraFiles Include="$(MSBuildProjectDirectory)\bin\Release\Direct3DVideoEncoder.dll" />
  </ItemGroup>
  <!-- Downloads and extracts the latest CineCapture release only when its ETag changes. -->
  <Target Name="UpdateCineCaptureLibraries" BeforeTargets="PrepareForBuild">
    <MakeDir Directories="$(CineCaptureDownloadDirectory);$(MSBuildProjectDirectory)\lib" />
    <Exec Command="curl --fail --location --silent --show-error --output NUL --write-out &quot;%%{url_effective}&quot; &quot;$(CineCaptureLatestReleaseUrl)&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CineCaptureReleaseOutput" />
    </Exec>
    <PropertyGroup>
      <_CineCaptureReleaseUrl>@(_CineCaptureReleaseOutput)</_CineCaptureReleaseUrl>
      <_CineCaptureReleaseTag>$([System.IO.Path]::GetFileName('$(_CineCaptureReleaseUrl)'))</_CineCaptureReleaseTag>
      <_CineCaptureAssetUrl>https://github.com/cine-capture/CineCapture/releases/latest/download/CineCapture-$(_CineCaptureReleaseTag)-windows-x64.zip</_CineCaptureAssetUrl>
    </PropertyGroup>
    <Exec Command="curl --fail --location --silent --show-error --etag-compare &quot;$(CineCaptureEtag)&quot; --etag-save &quot;$(CineCaptureDownloadedEtag)&quot; --output &quot;$(CineCaptureArchive)&quot; --write-out &quot;%%{http_code}&quot; &quot;$(_CineCaptureAssetUrl)&quot;"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_CineCaptureDownloadOutput" />
    </Exec>
    <PropertyGroup>
      <_CineCaptureHttpStatus>@(_CineCaptureDownloadOutput)</_CineCaptureHttpStatus>
    </PropertyGroup>
    <Error Condition="'$(_CineCaptureHttpStatus)' != '200' And '$(_CineCaptureHttpStatus)' != '304'"
           Text="Unexpected HTTP status $(_CineCaptureHttpStatus) while downloading CineCapture." />
    <Delete Files="$(MSBuildProjectDirectory)\lib\CineCapture.dll;$(MSBuildProjectDirectory)\lib\Direct3DVideoEncoder.dll" Condition="'$(_CineCaptureHttpStatus)' == '200'" />
    <Unzip SourceFiles="$(CineCaptureArchive)"
           DestinationFolder="$(MSBuildProjectDirectory)\lib"
           Condition="'$(_CineCaptureHttpStatus)' == '200'" />
    <Copy SourceFiles="$(CineCaptureDownloadedEtag)"
          DestinationFiles="$(CineCaptureEtag)"
          Condition="'$(_CineCaptureHttpStatus)' == '200'" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
